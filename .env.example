# ── Research Agent (web app, self-hosted) 환경변수 ──
# cp .env.example .env  후 값 채우기. docker compose / uvicorn 둘 다 사용.

# 백엔드 API 인증. 설정하면 /chat·/skills 호출에 Authorization: Bearer <token> 필요.
# 비우면 인증 비활성 (로컬 단독 사용).
RESEARCH_API_TOKEN=change-me

# 기본 채팅 모델 (provider:model). 웹 UI 모델 선택기로 전환 가능.
RESEARCH_MODEL=anthropic:claude-sonnet-4-5

# ── Provider API 키 (사용할 provider만 채우면 됨) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 채팅에서 Gemini(google-gla) 사용 시
GEMINI_API_KEY=
# figure/table 추출(Gemini Vision) — paper-ingest 할 거면 필요
GOOGLE_API_KEY=
# (선택) Semantic Scholar rate-limit 완화
SS_API_KEY=

# ── Vault ──
# host의 Obsidian vault 절대경로. 컨테이너 /vault 로 마운트됨.
# 반드시 Docker 파일공유 대상 경로 (홈 하위 ~/Documents 등은 기본 공유; /tmp는 공유 안 될 수 있음).
VAULT_HOST_PATH=/Users/you/Documents/research-wiki

# (선택) 세션 SQLite 경로. compose는 named volume(/data/sessions.db)로 자동 설정.
# 비우면 vault 의 _meta/sessions.db 사용 (Docker 없이 로컬 실행 시).
# RESEARCH_SESSIONS_DB=/data/sessions.db

# ── 프론트엔드 (web/.env.local 에 넣는 값; compose와 무관) ──
# NEXT_PUBLIC_API_URL=http://localhost:8000
